# TSH Client App Environment Variables
PORT=3002
NEXT_PUBLIC_API_URL=https://api.example.com

# Auth
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
AUTH_SECRET=your-auth-secret

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Sentry (optional)
SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# WhatsApp OTP
WHATSAPP_API_URL=https://api.example.com
WHATSAPP_API_TOKEN=your-token

# Meta measurement (server secrets stay blank in source control)
META_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_META_CAPI_ENABLED=false
META_GRAPH_API_VERSION=v25.0
META_CAPI_MODE=disabled
META_CAPI_EVENTS=PageView,ViewContent
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
META_CAPI_TEST_OPERATOR_SECRET=
META_MEASUREMENT_CONSENT_SECRET=
